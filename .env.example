# Public origin for canonical URLs, sitemap, social previews, and same-origin checks.
NEXT_PUBLIC_SITE_URL=https://www.gridandlogic.com

# Hostinger Email — SERVER ONLY. Use the password for this mailbox, not your hPanel login.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@gridandlogic.com
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=Grid & Logic <info@gridandlogic.com>
CONTACT_TO_EMAIL=info@gridandlogic.com

# Optional alternative to SMTP: Resend. Leave empty when using Hostinger SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional URL-prefix verification fallback. Use only the token from the client's
# account, not a complete HTML tag. Domain verification uses DNS instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
